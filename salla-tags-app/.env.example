PORT=3000
# رابط التطبيق العام (HTTPS) - يُستخدم في Redirect URL
APP_URL=https://your-app.example.com

# من لوحة شركاء سلة > التطبيق > OAuth
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# من إعدادات Webhooks في التطبيق (Signature secret)
SALLA_WEBHOOK_SECRET=

# مفتاح Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# مسار حفظ التوكنات وحالة المنتجات
DATA_FILE=./data/store.json
